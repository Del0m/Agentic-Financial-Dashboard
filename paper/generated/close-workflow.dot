digraph G {
rankdir=LR; bgcolor="white"; pad=0.3;
node [shape=box,style="rounded,filled",fillcolor="#eaf2f8",fontname="Helvetica"];
edge [fontname="Helvetica",fontsize=10,color="#566573"];
"start" -> "load_period";
"load_period" -> "expire_proposals" [style=dashed,label="conditional"];
"load_period" -> "record_error" [style=dashed,label="conditional"];
"load_period" -> "end" [style=dashed,label="conditional"];
"expire_proposals" -> "gather" [style=dashed,label="conditional"];
"expire_proposals" -> "record_error" [style=dashed,label="conditional"];
"gather" -> "adapt" [style=dashed,label="conditional"];
"gather" -> "record_error" [style=dashed,label="conditional"];
"adapt" -> "persist" [style=dashed,label="conditional"];
"adapt" -> "record_error" [style=dashed,label="conditional"];
"persist" -> "load_period" [style=dashed,label="conditional"];
"persist" -> "record_error" [style=dashed,label="conditional"];
"persist" -> "end" [style=dashed,label="conditional"];
"record_error" -> "end";
}